{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/startups.js": {
      "includeFiles": "server/data/startups.json",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}